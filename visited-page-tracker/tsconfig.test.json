{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["jest", "node"]
  },
  "include": [
    "tests/**/*.ts",
    "shared/**/*.ts",
    "storage/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
