{
  "compilerOptions": {
    /* Language level */
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    /* Strict checks */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* Output */
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,

    /* Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* Firefox WebExtension types */
    "types": ["firefox-webext-browser", "node"]
  },
  "include": [
    "background/**/*.ts",
    "content/**/*.ts",
    "storage/**/*.ts",
    "shared/**/*.ts",
    "options/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
